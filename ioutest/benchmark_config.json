    },
    "cutr-rgb-gravity": {
      "python": "/mnt/workspace/venvs/ca1m-ppu/bin/python",
      "adapter": "ioutest.adapters.cutr:CuTRAdapter",
      "semantic_labels": false,
      "options": {
        "project_root": "/mnt/workspace/CA1M",
        "checkpoint": "/mnt/workspace/CA1M/models/cutr_rgb.pth",
        "depth_model": false, "use_gravity": true
